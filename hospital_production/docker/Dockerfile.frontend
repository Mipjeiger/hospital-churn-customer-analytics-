##
## Stage 1: Build (also used as the dev environment)
##
FROM node:20-alpine AS builder
WORKDIR /app

COPY app/frontend/package.json app/frontend/package-lock.json ./
# Use `npm ci` but ensure dev deps are installed for vite
RUN npm ci --include=dev 

COPY app/frontend/ ./

# No build step here for dev. Just expose the dev port.
EXPOSE 8085

# The docker-compose `command` will override this, but set a fallback
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8085"]