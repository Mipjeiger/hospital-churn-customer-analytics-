FROM python:3.11-slim
ARG DNS1
ARG DNS2
RUN echo "nameserver ${DNS1}" > /etc/resolv.conf && echo "nameserver ${DNS2}" >> /etc/resolv.conf

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/app

COPY docker/resolv.conf /etc/resolv.conf
RUN echo "deb http://151.101.122.133/debian trixie main contrib non-free
deb http://151.101.122.133/debian trixie-updates main contrib non-free
deb http://151.101.122.133/debian-security trixie-security main contrib non-free" > /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends     build-essential     curl     git && pip install --no-cache-dir --upgrade pip && rm -rf /var/lib/apt/lists/*
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
    && pip install --no-cache-dir --upgrade pip \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements_api.txt /tmp/requirements_api.txt

RUN pip install --no-cache-dir -r /tmp/requirements_api.txt \
    && rm -rf /tmp/* /root/.cache

COPY app /app/app

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
