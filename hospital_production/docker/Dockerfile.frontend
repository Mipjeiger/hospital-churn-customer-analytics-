##
## Stage 1: Build
##
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies using lockfile for reproducibility
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci

# Copy all source files
COPY app/frontend/ ./

# Build environment — default to "/api" which nginx will reverse-proxy to http://fastapi:8000
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

##
## Stage 2: Serve with nginx
##
FROM nginx:stable-alpine AS production

# Custom nginx config for React Router & /api proxy to fastapi:8000
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf   

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8085
CMD ["nginx", "-g", "daemon off;"]
