##
## Stage 1: Build
##
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies using lockfile for reproducibility
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci

# Copy all source files
COPY app/frontend/ ./

# Build environment — API URL points to internal service name inside Docker network
ARG VITE_API_BASE_URL=http://fastapi:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

##
## Stage 2: Serve with nginx
##
FROM nginx:stable-alpine AS production

# Custom nginx config for React Router (SPA fallback to index.html)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8085
CMD ["nginx", "-g", "daemon off;"]
