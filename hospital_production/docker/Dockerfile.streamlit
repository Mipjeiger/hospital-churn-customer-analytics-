FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY docker/requirements_streamlit.txt /tmp/requirements_streamlit.txt

RUN pip install --no-cache-dir -r /tmp/requirements_streamlit.txt \
    && rm -rf /tmp/* /root/.cache

COPY app /app/app

EXPOSE 8501 8502

CMD ["streamlit", "run", "app/streamlit/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]