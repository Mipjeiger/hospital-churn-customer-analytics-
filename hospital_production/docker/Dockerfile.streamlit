FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY docker/requirements_streamlit.txt /tmp/requirements_streamlit.txt

RUN pip install --no-cache-dir -r /tmp/requirements_streamlit.txt \
    && rm -rf /tmp/* /root/.cache

COPY app/streamlit /app/app/streamlit

EXPOSE 8501

CMD ["streamlit", "run", "/app/app/streamlit/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]